    %vpi_call 2 13 "$dumpvars", 32'sb00000000000000000000000000000000, S_000001c57bd4ed90 {0 0 0};
    %vpi_call 2 15 "$monitor", "time %0dt | in=%b, sel=%b, a=%b, b=%b", $time, v000001c57bdd7f30_0, v000001c57bdd7fd0_0, v000001c57bd49210_0, v000001c57bd492b0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001c57bdd7f30_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001c57bdd7fd0_0, 0, 1;
    %delay 1, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001c57bdd7f30_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001c57bdd7fd0_0, 0, 1;
    %delay 1, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001c57bdd7f30_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001c57bdd7fd0_0, 0, 1;
    %delay 1, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001c57bdd7f30_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001c57bdd7fd0_0, 0, 1;
    %delay 1, 0;
    %vpi_call 2 20 "$finish" {0 0 0};

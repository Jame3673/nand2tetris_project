v000001c57bd49170_0 .net "sel", 0 0, v000001c57bdd7fd0_0;  1 drivers
E_000001c57bdda6d0 .event anyedge, v000001c57bd49170_0, v000001c57bd49030_0, v000001c57bd490d0_0;
    .scope S_000001c57bd48ea0;
T_0 ;
    %wait E_000001c57bdda6d0;
    %load/vec4 v000001c57bd49170_0;
    %inv;
    %store/vec4 v000001c57bd490d0_0, 0, 1;
    %load/vec4 v000001c57bd49030_0;
    %load/vec4 v000001c57bd490d0_0;
    %and;
    %store/vec4 v000001c57bd4ef20_0, 0, 1;
    %load/vec4 v000001c57bd49030_0;
    %load/vec4 v000001c57bd49170_0;
    %and;
    %store/vec4 v000001c57bd473d0_0, 0, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_000001c57bd4ed90;
T_1 ;

    %vpi_call 2 27 "$monitor", "Time=%t ps clk=%b | reset=%b load=%b inc=%b in=%0d | PC Out (address)=%0d", $time, v000001fdd30d08e0_0, v000001fdd30d16f0_0, v000001fdd30d0ac0_0, v000001fdd30d0a20_0, v000001fdd30d0980_0, v000001fdd30d0b60_0 {0 0 0};

builddir = run

rule compile_vvp
  command = iverilog -Wall -o $out $in
  description = Compiling $in -> $out

rule run_vvp
  command = vvp $in
  description = Running $in

build run/computer.vvp: compile_vvp computer_tb.v
build computer.vvp: phony run/computer.vvp

build run: run_vvp run/computer.vvp

default run
